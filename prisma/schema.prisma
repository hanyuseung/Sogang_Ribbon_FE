datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

model User {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now()) @map("created_at")
  email      String   @unique
  role       String   @default("user")
  nickname   String?
  password   String?
  profileUrl String?  @map("profile_url")
  bookmarks  PlaceBookmark[]

  @@map("user")
}

model Place {
  id             String  @id @default(uuid())
  name           String
  address        String?
  classification String?
  latitude       Float?
  longitude      Float?
  imgUrl         String? @map("img_url")
  ribbonCardinal Int?    @map("ribbon_cardinal")
  ribbonDeeped   Int?    @map("ribbon_deepred")
  ribbonPink     Int?    @map("ribbon_pink")
  descThumbnail  String? @map("desc_thumbnail")
  descDetail     String? @map("desc_detail")

  awardResults AwardRes[]
  bookmarks    PlaceBookmark[]

  @@map("place")
}

model PlaceBookmark {
  id      String @id @default(uuid())
  userId  String @map("user_id")
  placeId String @map("place_id")

  user  User  @relation(fields: [userId], references: [id])
  place Place @relation(fields: [placeId], references: [id])

  @@unique([userId, placeId])
  @@map("place_bookmark")
}

model Award {
  id        String    @id @default(uuid())
  name      String
  dateStart DateTime? @map("date_start")

  categories AwardCategory[]

  @@map("award")
}

model AwardCategory {
  id      String  @id @default(uuid())
  awardId String  @map("award_id")
  name    String?

  award   Award      @relation(fields: [awardId], references: [id])
  results AwardRes[]

  @@map("award_category")
}

model AwardRes {
  id              String  @id @default(uuid())
  awardCategoryId String  @map("award_category_id")
  placeId         String  @map("place_id")
  rank            Int?
  description     String?

  awardCategory   AwardCategory @relation(fields: [awardCategoryId], references: [id])
  place           Place         @relation(fields: [placeId], references: [id])

  @@map("award_res")
}
